+    /** Releases the presentation-owned artifact request and invalidates late reads. */
+    private fun clearArtifactPreview() {
+        artifactRequestSerial += 1L
+        _state.update {
+            it.copy(
+                activeArtifact = null,
+                artifactContent = null,
+                isArtifactLoading = false,
+                artifactError = null
+            )
+        }
+    }
